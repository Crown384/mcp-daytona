# Daytona MCP - private production worker
# Copy to .env.local locally. Never commit real values.

# Daytona API
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api

# GitHub App authentication
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_BASE64=

# Optional secure Pama Env Store machine integration (Worker server-side only)
# Configure the token with Cloudflare Worker secret management, never commit it.
PAMA_ENV_STORE_URL=
PAMA_ENV_STORE_TOKEN=
# Separate caller-auth secret for secret-enabled MCP calls (at least 32 characters).
PAMA_ENV_STORE_MCP_AUTH_TOKEN=
# Production is disabled by default; opt in only after security review.
PAMA_ENV_STORE_ALLOW_PRODUCTION=false
