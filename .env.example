# Daytona MCP - private production worker
# Copy to .env.local locally. Never commit real values.

# Daytona API
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api

# GitHub App authentication
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_BASE64=

# Optional secure Pama Env Store machine integration (Worker server-side only)
# Configure the token with Cloudflare Worker secret management, never commit it.
PAMA_ENV_STORE_URL=
PAMA_ENV_STORE_TOKEN=
# Separate caller-auth secret (at least 32 characters). MANDATORY for ALL sandbox tools when any Env Store integration setting is configured.
PAMA_ENV_STORE_MCP_AUTH_TOKEN=
# Explicit exact-case-insensitive GitHub owner/repo trust list for SECRET-ENABLED executions only.
# Required if env_store_project is requested. Other repo operations remain available.
PAMA_ENV_STORE_TRUSTED_REPOS=
# Production is disabled by default; opt in only after security review.
PAMA_ENV_STORE_ALLOW_PRODUCTION=false
