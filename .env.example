# Daytona MCP - private production worker
# Copy to .env locally. Never commit real values.

# Daytona API
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET=us

# GitHub access used inside the Daytona runner
GITHUB_TOKEN=
GITHUB_OWNER=Crown384

# Comma-separated repository names only, without the owner.
# Example: mcp-daytona,pamaos-next,pamastore
ALLOWED_GITHUB_REPOS=

# Private MCP endpoint secret. Use a long random value (24+ chars).
# ChatGPT private plugin URL: https://YOUR-DOMAIN/mcp?key=YOUR_MCP_API_KEY
MCP_API_KEY=
