# =============================================================================
# Daytona MCP environment variables
# Copy this file to `.env` for local development.
# In Cloudflare, add secret values with Wrangler/Cloudflare Secrets and plain
# configuration values as Worker environment variables.
# Never commit real secret values.
# =============================================================================

# -----------------------------------------------------------------------------
# Daytona
# -----------------------------------------------------------------------------

# REQUIRED — Daytona API key used by the server to create/manage sandboxes.
DAYTONA_API_KEY=

# OPTIONAL — Daytona API endpoint. Leave this default unless using another API.
DAYTONA_API_URL=https://app.daytona.io/api

# OPTIONAL — Sandbox region. Daytona currently supports `us` and `eu`.
DAYTONA_TARGET=us

# -----------------------------------------------------------------------------
# GitHub access used INSIDE the Daytona execution cycle
# -----------------------------------------------------------------------------

# REQUIRED — Fine-grained GitHub token used by the runner to clone private
# repositories and push the permitted execution results back to GitHub.
# Start with access only to the repositories we explicitly allow.
GITHUB_TOKEN=

# GitHub account/org that this MCP is allowed to operate against by default.
GITHUB_OWNER=Crown384

# Optional comma-separated repository allowlist.
# Example: pamaos-next,pamastore,mcp-daytona
# Leave empty only during initial MCP development; production should be explicit.
ALLOWED_GITHUB_REPOS=

# -----------------------------------------------------------------------------
# MCP authentication — GitHub OAuth
# -----------------------------------------------------------------------------
# Cloudflare's MCP OAuth flow uses a GitHub OAuth App to authenticate the person
# connecting the MCP client. Use separate GitHub OAuth Apps for localhost and
# production, but keep the same variable names in each environment.

# REQUIRED once OAuth is enabled.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# REQUIRED once OAuth is enabled — random 32-byte+ secret used to encrypt OAuth
# state/cookies. Example generator: `openssl rand -hex 32`.
COOKIE_ENCRYPTION_KEY=

# Only this GitHub login may authorize this private MCP initially.
ALLOWED_GITHUB_LOGIN=Crown384

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------

# Local: http://localhost:3000
# Production: e.g. https://daytona.pama.page
APP_URL=http://localhost:3000
