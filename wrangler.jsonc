{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mcp-daytona",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "secrets": {
    "required": ["DAYTONA_API_KEY", "GITHUB_TOKEN"]
  }
}
