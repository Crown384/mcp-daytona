{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mcp-daytona",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "routes": [
    {
      "pattern": "daytona-mcp.pama.page",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "secrets": {
    "required": ["DAYTONA_API_KEY", "GITHUB_APP_ID", "GITHUB_APP_PRIVATE_KEY_BASE64"]
  }
}
